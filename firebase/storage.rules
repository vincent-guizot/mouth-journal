rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Must match src/services/images/imageUpload.ts (MAX_IMAGE_BYTES, ALLOWED_IMAGE_TYPES).
    function isValidImage() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('^image/(jpeg|png|webp|heic|heif)$');
    }

    // Listing the user's own tree is needed for account deletion (listAll).
    match /users/{userId}/{allPaths=**} {
      allow list: if isOwner(userId);
    }

    // Only the four known folders, one level deep: users/{uid}/{folder}/{file}
    match /users/{userId}/{folder}/{fileName} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && folder in ['journals', 'menus', 'avatars', 'banners']
        && isValidImage();
      allow delete: if isOwner(userId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
