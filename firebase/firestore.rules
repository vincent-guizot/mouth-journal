rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ helpers
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function isIsoDate(v) {
      return v is string
        && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$');
    }

    function isShortString(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }

    function isSafeId(v) {
      return v is string && v.matches('^[A-Za-z0-9_.:-]{1,128}$');
    }

    function isStar(v) {
      return v is int && v >= 1 && v <= 5;
    }

    function isLat(v) {
      return v is number && v >= -90 && v <= 90;
    }

    function isLng(v) {
      return v is number && v >= -180 && v <= 180;
    }

    function isMainCategory(v) {
      return v in ['food', 'drinks', 'wisata'];
    }

    function isHttpsUrl(v) {
      return v is string && v.matches('^https://.+');
    }

    function validPhotoUrls(urls) {
      return urls is list && urls.size() <= 10
        && (urls.size() < 1 || isHttpsUrl(urls[0]))
        && (urls.size() < 2 || isHttpsUrl(urls[1]))
        && (urls.size() < 3 || isHttpsUrl(urls[2]));
    }

    function validMenuItem(m) {
      return m is map
        && m.keys().hasAll(['id', 'name', 'price'])
        && m.keys().hasOnly(['id', 'name', 'price', 'category', 'rating', 'isRecommended', 'photoUrl', 'notes'])
        && isSafeId(m.id)
        && isShortString(m.name, 1, 120)
        && m.price is int && m.price >= 0 && m.price <= 100000000
        && (!('rating' in m) || isStar(m.rating))
        && (!('photoUrl' in m) || isHttpsUrl(m.photoUrl))
        && (!('category' in m) || m.category in ['food', 'drink', 'dessert', 'snack'])
        && (!('isRecommended' in m) || m.isRecommended is bool)
        && optString(m, 'notes', 500);
    }

    function validMenuItems(items) {
      return items is list && items.size() <= 50
        && (items.size() < 1 || validMenuItem(items[0]))
        && (items.size() < 2 || validMenuItem(items[1]))
        && (items.size() < 3 || validMenuItem(items[2]));
    }

    function validTag(t) {
      return isShortString(t, 1, 40);
    }

    function validTags(tags) {
      return tags is list && tags.size() <= 20
        && (tags.size() < 1 || validTag(tags[0]))
        && (tags.size() < 2 || validTag(tags[1]))
        && (tags.size() < 3 || validTag(tags[2]))
        && (tags.size() < 4 || validTag(tags[3]))
        && (tags.size() < 5 || validTag(tags[4]));
    }

    // Absent optional fields are allowed; present ones must have the right type.
    function optString(data, key, max) {
      return !(key in data) || isShortString(data[key], 0, max);
    }

    // ------------------------------------------------------------ profile
    function validProfile(userId) {
      let d = incoming();
      return d.keys().hasAll(['uid', 'email', 'displayName'])
        && d.keys().hasOnly(['uid', 'email', 'displayName', 'username', 'phoneNumber', 'bio', 'photoURL',
          'bannerURL', 'culinaryPreferences', 'favoriteVenueTypes', 'budgetPerVisit', 'favoriteLocations',
          'socialInstagram', 'socialTikTok', 'createdAt', 'updatedAt'])
        && d.uid == userId
        && d.email is string
        && d.email == request.auth.token.email
        && isShortString(d.displayName, 1, 80)
        && (!('username' in d) || (d.username is string && d.username.matches('^[a-z0-9._]{3,30}$')))
        && optString(d, 'bio', 300)
        && optString(d, 'phoneNumber', 30)
        && (!('photoURL' in d) || (d.photoURL is string && d.photoURL.matches('^https://.+')))
        && (!('bannerURL' in d) || (d.bannerURL is string && d.bannerURL.matches('^https://.+')))
        && (!('createdAt' in d) || isIsoDate(d.createdAt))
        && (!('updatedAt' in d) || isIsoDate(d.updatedAt));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validProfile(userId);
      allow update: if isOwner(userId) && validProfile(userId)
        && (!('createdAt' in resource.data) || incoming().createdAt == resource.data.createdAt);
      allow delete: if isOwner(userId);

      // ---------------------------------------------------------- journals
      function validJournal(journalId) {
        let d = incoming();
        let c = d.criteriaRating;
        return d.keys().hasAll(['id', 'userId', 'placeId', 'placeName', 'placeAddress', 'mainCategory',
            'subCategory', 'subCategoryLabel', 'latitude', 'longitude', 'photoUrls', 'overallRating',
            'criteriaRating', 'menuItems', 'totalSpent', 'reviewText', 'tags', 'visitedAt', 'createdAt'])
          && d.keys().hasOnly(['id', 'userId', 'userName', 'placeId', 'placeName', 'placeAddress', 'mainCategory',
            'subCategory', 'subCategoryLabel', 'latitude', 'longitude', 'photoUrls', 'overallRating',
            'criteriaRating', 'menuItems', 'totalSpent', 'reviewText', 'tags', 'visitedAt', 'createdAt', 'updatedAt'])
          && d.id == journalId
          && d.userId == userId
          && isSafeId(d.placeId)
          && isShortString(d.placeName, 1, 200)
          && isShortString(d.placeAddress, 0, 300)
          && isMainCategory(d.mainCategory)
          && isShortString(d.subCategory, 1, 60)
          && isShortString(d.subCategoryLabel, 1, 60)
          && ((d.latitude == null && d.longitude == null) || (isLat(d.latitude) && isLng(d.longitude)))
          && validPhotoUrls(d.photoUrls)
          && c is map
          && c.keys().hasOnly(['taste', 'ambiance', 'service', 'price'])
          // `service` is a reserved word in the rules language, hence bracket access.
          && isStar(c['taste']) && isStar(c['ambiance']) && isStar(c['service']) && isStar(c['price'])
          && d.overallRating is number
          && d.overallRating == math.round((c['taste'] + c['ambiance'] + c['service'] + c['price']) * 10.0 / 4.0) / 10.0
          && validMenuItems(d.menuItems)
          && d.totalSpent is int && d.totalSpent >= 0
          && isShortString(d.reviewText, 0, 1000)
          && validTags(d.tags)
          && isIsoDate(d.visitedAt)
          && isIsoDate(d.createdAt)
          && (!('updatedAt' in d) || isIsoDate(d.updatedAt))
          && optString(d, 'userName', 120);
      }

      match /journals/{journalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validJournal(journalId) && !('updatedAt' in incoming());
        // Second branch: idempotent re-delivery of an already-applied write (the
        // offline queue may resend a create the SDK already delivered on reconnect).
        allow update: if isOwner(userId) && validJournal(journalId)
          && incoming().createdAt == resource.data.createdAt
          && incoming().userId == resource.data.userId
          && (('updatedAt' in incoming() && isIsoDate(incoming().updatedAt))
              || (!('updatedAt' in incoming()) && incoming() == resource.data));
        allow delete: if isOwner(userId);
      }

      // ---------------------------------------------------------- wishlist
      function validWishlist(itemId) {
        let d = incoming();
        return d.keys().hasAll(['id', 'userId', 'placeId', 'placeName', 'placeAddress', 'mainCategory',
            'subCategory', 'subCategoryLabel', 'latitude', 'longitude', 'createdAt'])
          && d.keys().hasOnly(['id', 'userId', 'placeId', 'placeName', 'placeAddress', 'mainCategory',
            'subCategory', 'subCategoryLabel', 'latitude', 'longitude', 'photoUrl', 'personalNotes', 'createdAt'])
          && d.id == itemId
          && d.placeId == itemId
          && isSafeId(itemId)
          && d.userId == userId
          && isShortString(d.placeName, 1, 200)
          && isShortString(d.placeAddress, 0, 300)
          && isMainCategory(d.mainCategory)
          && isShortString(d.subCategory, 1, 60)
          && isShortString(d.subCategoryLabel, 1, 60)
          && isLat(d.latitude) && isLng(d.longitude)
          && (!('photoUrl' in d) || (d.photoUrl is string && d.photoUrl.matches('^https://.+')))
          && optString(d, 'personalNotes', 500)
          && isIsoDate(d.createdAt);
      }

      match /wishlist/{itemId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && validWishlist(itemId);
        allow update: if isOwner(userId) && validWishlist(itemId)
          && incoming().createdAt == resource.data.createdAt;
        allow delete: if isOwner(userId);
      }

      // ---------------------------------------------------------- preferences
      function validSettings() {
        let d = incoming();
        let f = d.foodPreferences;
        return d.keys().hasAll(['appearance', 'searchRadiusKm', 'foodPreferences'])
          && d.keys().hasOnly(['appearance', 'locationPermissionsGranted', 'searchRadiusKm', 'useLocationForJournals',
            'distanceUnit', 'foodPreferences', 'lastBackupDate', 'appVersion'])
          && d.appearance in ['light', 'dark', 'system']
          && d.searchRadiusKm is number && d.searchRadiusKm >= 1 && d.searchRadiusKm <= 20
          && (!('distanceUnit' in d) || d.distanceUnit == 'km')
          && f is map
          && f.keys().hasOnly(['favoriteCategories', 'preferredVenueTypes', 'budgetPerVisit', 'defaultExploreFilters',
            'recommendationPreferences'])
          && f.favoriteCategories is list && f.favoriteCategories.size() <= 30
          && f.preferredVenueTypes is list && f.preferredVenueTypes.size() <= 30;
      }

      match /preferences/{docId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && docId == 'settings' && validSettings();
        allow delete: if isOwner(userId);
      }
    }

    // Everything else is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
